---
import Layout from '../layouts/Layout.astro'
import '../styles/index.css'

import {cards} from '../../content/cards.js'
import CardPair from '../components/card-pair.js'
---

<Layout title="卡牌图鉴 - Slay the Boss 原福">
	<article class="Container">
		<p><a class="Button" href="/">&larr; 菜单</a></p>

		<header class="Header">
			<h1 medium>Slay the Boss 原福</h1>
			<h2>共 {cards.length} 张卡牌图鉴</h2>
		</header>


		<div class="Box Box--text Box--full">
			<div class="Cards Cards--grid Cards--withUpgrades">
				{cards.map((card) => <CardPair card={card} gameState={{}} client:load />)}
			</div>
		</div>
	</article>
</Layout>
